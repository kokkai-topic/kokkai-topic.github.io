 "speeches": [
  {
   "date": "2026-06-12",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "中尾豊",
   "group": "政府・不明",
   "chars": 525,
   "excerpt": "○中尾政府参考人 脱炭素先行地域は、脱炭素と地域課題解決を同時に実現する、全国のモデルとなる地域であります。昨年度までに計百二の地域を選定し、当初の目標である少なくとも百地域を選定することについては、予定どおり終えたところであります。 今後",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01320260612/47"
  },
  {
   "date": "2026-06-12",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "鍋島勢理",
   "group": "国民民主党・無所属クラブ",
   "chars": 480,
   "excerpt": "○鍋島委員 ありがとうございます。 実際に先行地域に選ばれて、目標ですとかそのための計画を今各自治体は策定しておられますけれども、実際に私も拝見したところ、かなりハードルの高い数値を設定しておられる。もちろん、頑張っていく、そのために取組を",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01320260612/48"
  },
  {
   "date": "2026-06-12",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "中尾豊",
   "group": "政府・不明",
   "chars": 717,
   "excerpt": "○中尾政府参考人 地域脱炭素につきましては、既に九五％以上の自治体で地方公共団体実行計画が策定されている一方で、委員御指摘のとおり、小規模自治体を始めとして、具体的な施策の実行に当たりまして、財政力や専門性のある人材の面で課題があると認識し",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01320260612/49"
  },
  {
   "date": "2026-06-12",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "鍋島勢理",
   "group": "国民民主党・無所属クラブ",
   "chars": 586,
   "excerpt": "○鍋島委員 ありがとうございます。 地域脱炭素はそれ自体重要な取組であって、今後の将来の世代に対する責任という意味でもしっかりと取り組んでいかなければならないと思っております。 そういった意味では、今御答弁いただきましたように、各自治体行政",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01320260612/50"
  },
  {
   "date": "2026-06-12",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "中尾豊",
   "group": "政府・不明",
   "chars": 1097,
   "excerpt": "○中尾政府参考人 地域脱炭素を全国各地に広げる取組とするためには、委員御指摘のとおり、地域が抱える様々な課題を解決することに貢献するものとして脱炭素の取組を進めることが重要だと考えてございます。 幾つか例を申し上げさせていただきますと、例え",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01320260612/51"
  }
 ],
