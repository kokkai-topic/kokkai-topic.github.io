 "speeches": [
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "財務金融委員会",
   "speaker": "牧野俊一",
   "group": "参政党",
   "chars": 795,
   "excerpt": "○牧野委員 やはり、首都のバックアップを一か所だけに置くと、非常にそれはそれで危険だと思いますので、複数の場所にそれぞれ機能を分散させて配置していくということも考えていただくべきかなと思っております。 続きまして、特例公債法第五条の中に、持",
   "url": "https://kokkai.ndl.go.jp/txt/122104376X00420260310/191"
  },
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "財務金融委員会",
   "speaker": "佐藤大作",
   "group": "政府・不明",
   "chars": 580,
   "excerpt": "○佐藤政府参考人 お答えいたします。 現行制度上、医療用医薬品は、原則として、医師又は歯科医師が、診察や検査等から得られた患者の心身の状況に関する医学的な判断を踏まえまして、疾病等の治療のために選択をし、処方する必要があるものとして位置づけ",
   "url": "https://kokkai.ndl.go.jp/txt/122104376X00420260310/192"
  },
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "財務金融委員会",
   "speaker": "牧野俊一",
   "group": "参政党",
   "chars": 576,
   "excerpt": "○牧野委員 ありがとうございます。 まさに、いろいろな発熱外来とか風邪の患者さんたちに、何か市販薬は使われていますかと聞いたら、これこれを使っていますとおっしゃって、中身の成分を見たら、それは、病院で一個一個、錠剤に一種類ずつ分かれて処方す",
   "url": "https://kokkai.ndl.go.jp/txt/122104376X00420260310/193"
  },
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "財務金融委員会",
   "speaker": "江浪武志",
   "group": "政府・不明",
   "chars": 443,
   "excerpt": "○江浪政府参考人 ＯＴＣ類似薬の保険給付の見直しに関しましては、必要な受診は確保した上で、ＯＴＣ医薬品との代替性が特に高い薬剤を用いた療養などについて、患者さんに追加の御負担をいただくというものでありまして、そのための関係法案を今国会に提出",
   "url": "https://kokkai.ndl.go.jp/txt/122104376X00420260310/194"
  }
 ],
