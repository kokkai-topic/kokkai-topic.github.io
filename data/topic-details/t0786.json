 "speeches": [
  {
   "date": "2026-06-24",
   "house": "衆議院",
   "meeting": "文部科学委員会",
   "speaker": "村上智信",
   "group": "日本維新の会",
   "chars": 1074,
   "excerpt": "○村上（智）委員 ありがとうございました。 いずれも教員の働き方改革において有効だと思えるので、積極的に取り組んでいただきたいと思います。 特別支援学校では、学級の定員が少ないので、学級ごとに一つの教室が割り当てられているわけではありません",
   "url": "https://kokkai.ndl.go.jp/txt/122105124X01320260624/44"
  },
  {
   "date": "2026-06-24",
   "house": "衆議院",
   "meeting": "文部科学委員会",
   "speaker": "坂本修一",
   "group": "政府・不明",
   "chars": 216,
   "excerpt": "○坂本政府参考人 お答えいたします。 委員御指摘の研究については、既に御質問の中でお話がございましたけれども、ニッケルなどの金属に水素を吸蔵させて加熱などを行うことにより、入力よりも大きい熱エネルギーが発生する現象に関する研究であると承知し",
   "url": "https://kokkai.ndl.go.jp/txt/122105124X01320260624/45"
  },
  {
   "date": "2026-06-24",
   "house": "衆議院",
   "meeting": "文部科学委員会",
   "speaker": "村上智信",
   "group": "日本維新の会",
   "chars": 898,
   "excerpt": "○村上（智）委員 ありがとうございました。 低温核融合は一般的には余り知られていないのですけれども、これは経緯があるから仕方がないことだというふうに思っております。 一九九〇年頃に常温核融合が話題になりました。とある外国の研究者が、常温で重",
   "url": "https://kokkai.ndl.go.jp/txt/122105124X01320260624/46"
  },
  {
   "date": "2026-06-24",
   "house": "衆議院",
   "meeting": "文部科学委員会",
   "speaker": "松本洋平",
   "group": "自由民主党・無所属の会",
   "chars": 739,
   "excerpt": "○松本（洋）国務大臣 フュージョンエネルギーは、エネルギー問題と地球環境問題を同時に解決をいたします次世代のエネルギーでありまして、政府として、世界に先駆けた二〇三〇年代の発電実証の実現を目指した取組を進めているところであります。 他方で、",
   "url": "https://kokkai.ndl.go.jp/txt/122105124X01320260624/47"
  },
  {
   "date": "2026-06-24",
   "house": "衆議院",
   "meeting": "文部科学委員会",
   "speaker": "村上智信",
   "group": "日本維新の会",
   "chars": 294,
   "excerpt": "○村上（智）委員 大臣の御答弁にありました技術力を持つ国が核融合を握るという話はまさにそうだと思いまして、特に低温核融合は金属の作り方にポイントがありまして、金属を原子レベルで制御する、一層、二層、三層と積み上げていくというのは日本でしかで",
   "url": "https://kokkai.ndl.go.jp/txt/122105124X01320260624/48"
  }
 ],
 "speechesTruncated": false
}