 "speeches": [
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "総務委員会",
   "speaker": "中川宏昌",
   "group": "中道改革連合・無所属",
   "chars": 522,
   "excerpt": "○中川（宏）委員 よろしくお願いいたします。 次に、地方自治体にとって喫緊の課題であります公営企業とインフラ老朽化についてお伺いをさせていただきたいと思います。 今回の地方財政法改正によりまして、当分の間の措置といたしまして、公営企業経営改",
   "url": "https://kokkai.ndl.go.jp/txt/122104601X00320260310/86"
  },
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "総務委員会",
   "speaker": "出口和宏",
   "group": "政府・不明",
   "chars": 490,
   "excerpt": "○出口政府参考人 お答えをいたします。 人口減少が続くことが想定される中、これまで公営企業が提供してきたサービスを将来にわたって持続的に地域において確保していくためには、上下水道の広域化などの経営改善の取組を進めることが重要になってまいりま",
   "url": "https://kokkai.ndl.go.jp/txt/122104601X00320260310/87"
  },
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "総務委員会",
   "speaker": "岩谷良平",
   "group": "日本維新の会",
   "chars": 1034,
   "excerpt": "○岩谷委員 日本維新の会の岩谷良平です。よろしくお願いいたします。 まず、公営企業経営改善特例債に関連しまして、水道事業の広域化についてお伺いをいたします。 私の地元であります大阪では、広域水道企業団による浄水場の統廃合や、スケールメリット",
   "url": "https://kokkai.ndl.go.jp/txt/122104601X00320260310/159"
  },
  {
   "date": "2026-03-10",
   "house": "衆議院",
   "meeting": "総務委員会",
   "speaker": "出口和宏",
   "group": "政府・不明",
   "chars": 503,
   "excerpt": "○出口政府参考人 お答えをいたします。 水道事業につきましては、人口減少等による料金収入の減少や、施設の老朽化に伴う更新需要の増大、技術職員の不足などによりまして、経営環境が厳しさを増しております。 将来にわたり持続可能な経営を確保するため",
   "url": "https://kokkai.ndl.go.jp/txt/122104601X00320260310/160"
  }
 ],
