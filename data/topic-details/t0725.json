 "speeches": [
  {
   "date": "2026-05-22",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "柏倉祐司",
   "group": "日本維新の会",
   "chars": 263,
   "excerpt": "○柏倉委員 ありがとうございます。 令和八年度中に施設基準、これは努力をしていただけるということでございますので、是非そのようにお願いをしたいと思います。 続きまして、このスクラップヤードと関連して、重金属の盗難についてお伺いさせていただき",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01020260522/54"
  },
  {
   "date": "2026-05-22",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "服部準",
   "group": "政府・不明",
   "chars": 269,
   "excerpt": "○服部政府参考人 お答えいたします。 金属盗の認知件数は、令和六年は二万七百一件、令和七年は一万五千七百十二件でありまして、約五千件の減少となっております。また、社会問題化した太陽光発電施設における金属ケーブル窃盗の認知件数は、令和七年から",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01020260522/55"
  },
  {
   "date": "2026-05-22",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "柏倉祐司",
   "group": "日本維新の会",
   "chars": 665,
   "excerpt": "○柏倉委員 ありがとうございます。 既に施行されている部分で、この効果というものがマイナス百件ですか、同月比であるということで、非常にすばらしいなというふうには思いますが、ただ、今年の六月一日から、もうすぐ、金属売買における本人確認の部分が",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01020260522/56"
  },
  {
   "date": "2026-05-22",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "服部準",
   "group": "政府・不明",
   "chars": 282,
   "excerpt": "○服部政府参考人 お答えいたします。 金属盗対策法におきましては、マイナンバーカード、運転免許証、在留カードを始めとする顔写真つきの本人確認書類によって、買受けの相手方の氏名、住居、生年月日等の本人特定事項の確認を義務づけておりまして、これ",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01020260522/57"
  },
  {
   "date": "2026-05-22",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "柏倉祐司",
   "group": "日本維新の会",
   "chars": 420,
   "excerpt": "○柏倉委員 私が申し上げているのは、本人確認はできても、在留資格があるのかどうかというところの確認ができないのではないかということを申し上げているわけでございます。そこを、金属盗対策法関連だけではなくて、今後やはり様々な外国人犯罪に対応する",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01020260522/58"
  },
  {
   "date": "2026-05-22",
   "house": "衆議院",
   "meeting": "環境委員会",
   "speaker": "服部準",
   "group": "政府・不明",
   "chars": 333,
   "excerpt": "○服部政府参考人 お答えいたします。 外国籍と思われる方に対して原則として在留カードでの本人確認を求めることとした場合、買受け業者に対し、目の前にいる顧客が外国籍であるか否かの確認をさせることになりまして、買受け業者に負担を課すことにもなり",
   "url": "https://kokkai.ndl.go.jp/txt/122104006X01020260522/59"
  }
 ],
