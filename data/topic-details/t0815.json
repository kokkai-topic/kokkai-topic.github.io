 "speeches": [
  {
   "date": "2026-07-14",
   "house": "衆議院",
   "meeting": "安全保障委員会",
   "speaker": "鹿嶋祐介",
   "group": "自由民主党・無所属の会",
   "chars": 990,
   "excerpt": "○鹿嶋委員 ありがとうございます。 私の同僚が防衛駐在官をやっておりますので、小泉大臣をお支えしているというのを聞いて安心したところであります。 さて、今いろいろな取組についてお伺いいたしましたが、やはり私、鹿嶋としては、現状の体制では限界",
   "url": "https://kokkai.ndl.go.jp/txt/122103815X00820260714/11"
  },
  {
   "date": "2026-07-14",
   "house": "衆議院",
   "meeting": "安全保障委員会",
   "speaker": "小泉進次郎",
   "group": "自由民主党・無所属の会",
   "chars": 542,
   "excerpt": "○小泉国務大臣 その点、鹿嶋先生と全く同感であります。 自衛隊員の確保は政府を挙げて取り組むべき至上命題であり、現職の自衛隊員の処遇改善に加え、国防の任務を全うした退職自衛隊員や、平素から自衛隊員を支える御家族も、誇りを持って安心して生活で",
   "url": "https://kokkai.ndl.go.jp/txt/122103815X00820260714/12"
  },
  {
   "date": "2026-07-14",
   "house": "衆議院",
   "meeting": "安全保障委員会",
   "speaker": "鹿嶋祐介",
   "group": "自由民主党・無所属の会",
   "chars": 283,
   "excerpt": "○鹿嶋委員 力強い答弁をありがとうございます。 退職自衛隊員そして家族を支援する取組、この検討を是非前向きに進めていただきたいというふうに考えています。 自衛官の処遇改善は当然進めるべきです。それに加えて、事に臨んでは危険を顧みず、身をもっ",
   "url": "https://kokkai.ndl.go.jp/txt/122103815X00820260714/13"
  }
 ],
