 "speeches": [
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "安達悠司",
   "group": "参政党",
   "chars": 688,
   "excerpt": "○安達悠司君 参政党の安達悠司です。 本日は、生成ＡＩや外国資本の土地買収を中心に質問します。 先日の野球監督の事件でも、生成ＡＩに対する相談が話題となりました。本年二月に内閣府の消費者委員会が実施した生成ＡＩに関するアンケート調査では、生",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/90"
  },
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "恒藤晃",
   "group": "政府・不明",
   "chars": 281,
   "excerpt": "○政府参考人（恒藤晃君） お答えいたします。 一般論として申し上げますと、生成ＡＩにおきましては、誤った情報や倫理上好ましくない回答など、不適切な出力をする場合があると承知をしてございます。 その主な要因といたしましては、生成ＡＩは、あらか",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/91"
  },
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "恒藤晃",
   "group": "政府・不明",
   "chars": 259,
   "excerpt": "○政府参考人（恒藤晃君） 内閣府といたしましては、ＡＩ法に基づき昨年十二月に作成いたしましたＡＩの適正性確保に関する指針に基づきまして、不適切な出力の抑制に向けて最新の技術と知見を活用して取り組むよう促しているところでございます。こうしたこ",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/93"
  },
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "安達悠司",
   "group": "参政党",
   "chars": 322,
   "excerpt": "○安達悠司君 要するに、生成ＡＩというのは統計学や確率論を基礎としていて、誤情報や倫理的に正しくない情報が一定程度避けられないのだとすると、やはりその生成ＡＩの限界をきちんと国民に周知すべきだと思います。また、監督官庁もありませんので、そう",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/94"
  },
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "佐藤淳",
   "group": "政府・不明",
   "chars": 272,
   "excerpt": "○政府参考人（佐藤淳君） お答えいたします。 犯罪の成否は、捜査機関により収集された証拠に基づき個別に判断されるべき事柄でありますので、法務当局としてはお答えを差し控えますけれども、その上で、あくまで一般論として申し上げますと、刑法二百二条",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/95"
  },
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "松井信憲",
   "group": "政府・不明",
   "chars": 421,
   "excerpt": "○政府参考人（松井信憲君） 私からは民法を所管する立場から御答弁申し上げますが、お尋ねのような事案においてＡＩ事業者が民法上の不法行為責任を負うかどうかについては、個別の事案における具体的な事情に即して判断する必要があり、一概にお答えするこ",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/96"
  },
  {
   "date": "2026-06-18",
   "house": "参議院",
   "meeting": "法務委員会",
   "speaker": "安達悠司",
   "group": "参政党",
   "chars": 711,
   "excerpt": "○安達悠司君 要するに、事業者が自殺防止のための安全配慮に関していかなる注意義務を負っているかということであり、また、具体的注意義務としてとるべき措置や対策の中身というのを、これは、日本でもこのような、自殺のような、あるいはそれを訴えるよう",
   "url": "https://kokkai.ndl.go.jp/txt/122115206X01620260618/97"
  }
