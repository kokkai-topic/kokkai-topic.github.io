   "url": "https://kokkai.ndl.go.jp/txt/122103815X00820260714/52"
  },
  {
   "date": "2026-07-14",
   "house": "衆議院",
   "meeting": "安全保障委員会",
   "speaker": "橋本幹彦",
   "group": "国民民主党・無所属クラブ",
   "chars": 837,
