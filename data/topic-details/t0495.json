 "speeches": [
  {
   "date": "2026-04-10",
   "house": "衆議院",
   "meeting": "経済産業委員会",
   "speaker": "湯本啓市",
   "group": "政府・不明",
   "chars": 389,
   "excerpt": "○湯本政府参考人 お答え申し上げます。 委員御指摘のとおり、国内管理人制度につきましては、昨年末に施行した改正製品安全四法におきまして海外事業者を規制対象とした際、その実効的な執行を確保するため導入した制度でございます。 具体的には、海外事",
   "url": "https://kokkai.ndl.go.jp/txt/122104080X00220260410/121"
  },
  {
   "date": "2026-04-10",
   "house": "衆議院",
   "meeting": "経済産業委員会",
   "speaker": "阿部司",
   "group": "日本維新の会",
   "chars": 387,
   "excerpt": "○阿部（司）委員 電話でも一件一件確認いただいているということで、是非継続的な監視をお願いできればと思います。 その上で、もう一歩ちょっとお願いをしてまいりたいと思うんですけれども、製品安全の一義的な責任が特定輸入事業者にあることは承知をし",
   "url": "https://kokkai.ndl.go.jp/txt/122104080X00220260410/122"
  },
  {
   "date": "2026-04-10",
   "house": "衆議院",
   "meeting": "経済産業委員会",
   "speaker": "赤澤亮正",
   "group": "自由民主党・無所属の会",
   "chars": 255,
   "excerpt": "○赤澤国務大臣 改正製品安全四法で措置された海外事業者に対する規制の実効性を確保するため、事業者に代わって政府とのやり取りを担う国内管理人の制度を適切に執行していくことが重要でございます。 このため、海外事業者が選任する国内管理人に検査記録",
   "url": "https://kokkai.ndl.go.jp/txt/122104080X00220260410/123"
  },
  {
   "date": "2026-04-10",
   "house": "衆議院",
   "meeting": "経済産業委員会",
   "speaker": "阿部司",
   "group": "日本維新の会",
   "chars": 89,
   "excerpt": "○阿部（司）委員 是非消費者の安全が守られるように引き続きお取組を進めていただけるようお願い申し上げまして、私の質疑を終わりとさせていただきたいと思います。 ありがとうございました。",
   "url": "https://kokkai.ndl.go.jp/txt/122104080X00220260410/124"
  }
 ],
